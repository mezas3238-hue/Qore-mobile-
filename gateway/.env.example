# QORE Mobile Gateway configuration example.
# DO NOT put real secrets or production tokens in this file.

# Runtime records contain runtime_id, allowed account_ids and a runtime-specific
# secret. Production values must be injected by deployment secret management.
QORE_RUNTIME_CREDENTIALS_JSON=[]

# SHA-256 hashes of temporary mobile read tokens.
# This foundation boundary will later be replaced by device-bound sessions.
QORE_MOBILE_READ_TOKEN_HASHES_JSON=[]
