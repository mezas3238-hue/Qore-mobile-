# QORE Mobile Gateway configuration example.
# DO NOT put real secrets, tokens or enrollment codes in this file.

# Runtime records contain runtime_id, allowed account_ids and a runtime-specific
# signing secret. Production values must come from deployment secret management.
QORE_RUNTIME_CREDENTIALS_JSON=[]

# SHA-256 hashes of one-time device enrollment codes.
# Raw enrollment codes must be delivered out-of-band and never committed.
QORE_MOBILE_ENROLLMENT_CODE_HASHES_JSON=[]

# SHA-256 hashes of administration tokens used only for mobile-device
# revocation/security administration. They do not authorize trading actions.
QORE_MOBILE_ADMIN_TOKEN_HASHES_JSON=[]
