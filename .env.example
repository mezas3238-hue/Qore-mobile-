# Only public Supabase URL and ANON / PUBLISHABLE key are used by clients.
# Obtain them from the existing ViajeYa Supabase project's configuration.
# Never use a service-role key, database password or private key in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Build-time only (EAS secret variable, do not commit):
# GOOGLE_MAPS_ANDROID_API_KEY=
# Restrict this key in Google Cloud to com.qore.viajeya + Android signing SHA-1.
