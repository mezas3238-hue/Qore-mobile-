# Pruebas privadas de autenticación en Android/iOS solamente.
# URL del proyecto STAGING Supabase auditado: no usar producción.
EXPO_PUBLIC_SUPABASE_URL=
# Clave pública sb_publishable_, NO service_role, NO sb_secret_, NO JWT privado.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Los viajes/despachos reales continúan deshabilitados mientras A
# no publique HTTPS persistente + Auth + cobertura/peajes certificados.
EXPO_PUBLIC_LIVE_OPERATIONS_ENABLED=false

# Únicamente después de autorización Owner y despliegue STAGING:
# ambos deben coincidir EXACTAMENTE y apuntar a HTTPS <servicio>.onrender.com.
# Habilita SOLO la prueba de conectividad en Cuenta; no reserva viajes.
EXPO_PUBLIC_F1_STAGING_ORIGIN=
EXPO_PUBLIC_F1_STAGING_PINNED_ORIGIN=

# Se habilita el flujo Cliente->G73 SOLO tras pruebas independientes con A,
# proyecto persistente, ruteo verificado y aprobación explícita del Owner.
# Estos flags de compilación jamás sustituyen RBAC, IdP, SQL o permisos legales.
# Por defecto: SIN cotizaciones, SIN reservas, SIN tráfico comercial.
EXPO_PUBLIC_F1_OWNER_APPROVED=false
EXPO_PUBLIC_F1_G73_CONTRACT_VERIFIED=false
EXPO_PUBLIC_F1_PG_RUNTIME_VERIFIED=false
EXPO_PUBLIC_F1_ROUTE_PROVIDER_VERIFIED=false
