# Driver: únicamente proyecto STAGING Supabase previamente autorizado.
# Nunca servicio real, service_role, sb_secret ni contraseñas en Git.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_LIVE_OPERATIONS_ENABLED=false

# G115: solo para una build STAGING con autorización explícita del Owner.
# Sin los tres valores, el root no monta ningún gateway. NO producción.
# Este flag NO reemplaza controles legales, KYC ni autenticación del servidor.
EXPO_PUBLIC_QORE_STAGING_RUNTIME_APPROVED=false
EXPO_PUBLIC_QORE_STAGING_API_ORIGIN=
EXPO_PUBLIC_QORE_STAGING_API_HOST=
