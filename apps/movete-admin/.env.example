# Solo proyecto Supabase STAGING autorizado con roles Admin/Owner previamente
# aprovisionados y factor TOTP verificado. No poner contraseñas aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend G75 y operaciones comerciales siguen inactivos hasta HTTPS+
# PostgreSQL persistente + verificación MFA AAL2 del lado del servidor.

# G75 Admin F1 — todos los flags OFF. NO habilitar con G99 PG16 local;
# exigir primero Owner + PostgreSQL STAGING externo + HTTPS autorizado,
# IdP AAL2/TOTP verificado en backend + RBAC exclusivo + revocación real.
# Estos VITE_ son parámetros públicos del build, NUNCA secretos/tokens.
VITE_F1_STAGING_ORIGIN=
VITE_F1_STAGING_PINNED_ORIGIN=
VITE_F1_OWNER_APPROVED=false
VITE_F1_EXTERNAL_HTTPS_VERIFIED=false
VITE_F1_G75_CONTRACT_VERIFIED=false
VITE_F1_PG_RUNTIME_VERIFIED=false
VITE_F1_ADMIN_SERVER_MFA_VERIFIED=false
VITE_F1_ADMIN_SERVER_RBAC_VERIFIED=false
VITE_F1_ADMIN_SERVER_REVOCATION_VERIFIED=false

# G116 Owner comisiones AUTO/MOTO — TODAS las banderas OFF por defecto.
# Nunca habilitar por pasar tests sintéticos: exige Owner que apruebe
# expresamente STAGING, servidor HTTPS externo con PostgreSQL persistente,
# JWT/audiencia, rol Owner exclusivo, MFA AAL2 y revocación comprobados.
# Variables VITE_ son públicas: JAMÁS almacenar secretos, JWT o contraseña.
VITE_G116_OWNER_COMMISSION_ENABLED=false
VITE_G116_OWNER_CONTRACT_VERIFIED=false
VITE_G116_OWNER_ORIGIN=
VITE_G116_OWNER_PINNED_ORIGIN=

# Arquitecto D #18 — same serviceId trace, all OFF by default.
# A must independently certify external PG16, RBAC, JWT AAL2 and revocation.
VITE_D_TRACE_STAGING_ORIGIN=
VITE_D_TRACE_PINNED_ORIGIN=
VITE_D_TRACE_OWNER_APPROVED=false
VITE_D_TRACE_EXTERNAL_HTTPS_VERIFIED=false
VITE_D_TRACE_CONTRACT_VERIFIED=false
VITE_D_TRACE_PG_VERIFIED=false
VITE_D_TRACE_SERVER_MFA_VERIFIED=false
VITE_D_TRACE_SERVER_RBAC_VERIFIED=false
VITE_D_TRACE_REVOCATION_VERIFIED=false

# G124 Owner cargo rates (AUTO/MOTO delivery): all OFF until verified
# Separate from passenger G116 percentages and 10% passenger subsidy.
VITE_G124_OWNER_CARGO_ENABLED=false
VITE_G124_OWNER_CARGO_CERTIFIED=false
VITE_G124_OWNER_CARGO_ORIGIN=
VITE_G124_OWNER_CARGO_PINNED_ORIGIN=

# G27 Admin read-only HTTP gateway. OFF by default, per-operation allowlist.
# A must mount+certify each endpoint externally with Owner/PG/JWT/AAL2/RBAC.
# These variables are PUBLIC BUILD FLAGS; never paste tokens or secrets.
VITE_D_READ_STAGING_ORIGIN=
VITE_D_READ_PINNED_ORIGIN=
VITE_D_READ_OWNER_APPROVED=false
VITE_D_READ_EXTERNAL_HTTPS_VERIFIED=false
VITE_D_READ_CONTRACT_VERIFIED=false
VITE_D_READ_PG_VERIFIED=false
VITE_D_READ_SERVER_MFA_VERIFIED=false
VITE_D_READ_SERVER_RBAC_VERIFIED=false
VITE_D_READ_REVOCATION_VERIFIED=false
VITE_D_READ_VERIFIED_OPERATIONS=


# G156 Merchant staff portal: only enable after owner-approved external
# HTTPS + PG + provider revocation + isolated merchant staff verification.
# NEVER use CI loopback, synthetic sessions, service_role or LIVE.
VITE_G156_MERCHANT_PORTAL_ENABLED=false
VITE_G156_EXTERNAL_RUNTIME_VERIFIED=false
VITE_G156_PROVIDER_REVOCATION_VERIFIED=false
VITE_G156_MERCHANT_ORIGIN=
VITE_G156_MERCHANT_PINNED_ORIGIN=
