{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --ignore-scripts --no-audit --no-fund --package-lock=false"
  },
  "deploy": {
    "startCommand": "node server/run-g4-railway-staging.mjs",
    "healthcheckPath": "/_qore/liveness",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
