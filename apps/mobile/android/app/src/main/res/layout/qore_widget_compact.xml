<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qore_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/qore_widget_bg_solid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/qore_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QORE"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/white" />
        <TextView
            android:id="@+id/qore_widget_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHADOW"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="#818CF8" />
    </LinearLayout>

    <TextView
        android:id="@+id/qore_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UNKNOWN"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="#9CA3AF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/qore_widget_equity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Equity"
            android:textSize="10sp"
            android:textColor="#9CA3AF" />
        <TextView
            android:id="@+id/qore_widget_equity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <TextView android:id="@+id/qore_widget_balance_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_balance" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_pnl_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_pnl" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_dd_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_dd" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_positions_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_positions" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_runtimes_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_runtimes" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_traders_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/qore_widget_traders" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView
        android:id="@+id/qore_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Snapshot seguro"
        android:textSize="9sp"
        android:textColor="#9CA3AF" />
</LinearLayout>
